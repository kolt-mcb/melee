  # melee — browser build of Kolt's Melee port (page + /disc.iso + /net relay).
  # Not an access-gate tenant: plain Caddy vhost, same SSO. See the vhost block
  # in caddy/Caddyfile and the wiki page melee-pc-port.
  melee:
    build: /home/grunt/melee-web
    image: melee-web:local
    container_name: melee
    restart: unless-stopped
    # Its own network, shared with Caddy alone (install-compose-block.py adds
    # melee-net at the top level and attaches caddy; node1-apply.sh connects
    # the running caddy to it without a restart). On the shared `gateway`
    # bridge every other tenant container reached this port with no SSO at
    # all -- the gate is Caddy's, and this container trusts whatever reaches
    # 8000, X-Forwarded-Email included.
    networks: [melee-net]
    # The datagram channel for game inputs (tools/wasm/rtc.js): one UDP port,
    # the same number inside and out, NOT through Caddy (it is not HTTP).
    # MELEE_RTC_HOST is the address the players' browsers reach this host's
    # port on -- grunt-node1's LAN address, not Caddy's macvlan one that
    # melee.mcbridefarm.com resolves to. Unset or unreachable, every page
    # simply keeps its inputs on the /net WebSocket, as before.
    ports:
      # Bound to ONE host address (MELEE_RTC_BIND, the host's LAN address), not
      # 0.0.0.0: a bare "9400:9400/udp" listens on every host interface -- the
      # VM bridge, the docker bridges -- not just the intended LAN path. Set it
      # in the gateway .env alongside MELEE_RTC_HOST; unset, it binds loopback
      # only and no page can open a channel (they keep to the WebSocket), which
      # is the safe way to fail. Packets a router forwards (or punches through
      # to) this host's LAN address land on this bind.
      - "${MELEE_RTC_BIND:-127.0.0.1}:9400:9400/udp"
    environment:
      # The image ships with it off; on once the port and the host are set.
      MELEE_RTC: "${MELEE_RTC:-0}"
      MELEE_RTC_PORT: "9400"
      MELEE_RTC_HOST: "${MELEE_RTC_HOST:-}"
      # A STUN server for the players' browsers (rtc.js). Set, and with a
      # pfSense "static port" outbound NAT rule for this host's UDP 9400, a
      # remote player's channel opens through the router's own outbound state
      # and the WAN port forward can be removed. Empty = LAN or forward only.
      MELEE_STUN: "${MELEE_STUN:-}"
    volumes:
      - /home/grunt/melee-web/web:/web:ro
      - /home/grunt/melee-web/disc.iso:/disc/disc.iso:ro
      # The server code too, so a deploy is a copy and not a new container:
      # recreating it empties the lobby and ends every match in progress.
      - /home/grunt/melee-web/tools/wasm:/app/tools/wasm:ro
      # /reports must be a host dir: in the container's writable layer every
      # `up -d --build melee` deleted every frame report ever written (2026-10-17).
      - /home/grunt/melee-reports:/reports
    healthcheck:
      test: ["CMD", "wget", "-q", "-O", "/dev/null", "http://127.0.0.1:8000/healthz"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 10s
