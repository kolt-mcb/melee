+void CEXISlippi::directModeAutoDrive()
+{
+	// Installed here, not in the constructor: DolphinWX's frame installs its
+	// own TAS manip function while it sets itself up, which is after the EXI
+	// device exists, so anything registered earlier is simply replaced.
+	// controller_map from a hook that runs on every screen, not just the
+	// character select. prepareOnlineMatchState only runs on that one screen, so
+	// reading it there cannot say whether the buffer was ever populated. This
+	// runs from the command dispatch, which the game uses everywhere.
+	if (getenv("SLIPPI_DIRECT_PEERS") != nullptr)
+	{
+		static int mapTick = 0;
+		if ((mapTick++ % 5) == 0)
+		{
+			u8 major = PowerPC::HostRead_U8(0x80479D30);
+			u8 minor = PowerPC::HostRead_U8(0x80479D33);
+			// Both halves of the u64, for controller 1 and the all-controllers
+			// union, plus the trigger word: reading one half and finding zero
+			// proves nothing about where the bits actually sit.
+			u32 p1hi = PowerPC::HostRead_U32(0x80479C30);
+			u32 p1lo = PowerPC::HostRead_U32(0x80479C30 + 4);
+			u32 alhi = PowerPC::HostRead_U32(0x80479C30 + 4 * 0x30);
+			u32 allo = PowerPC::HostRead_U32(0x80479C30 + 4 * 0x30 + 4);
+			u32 trhi = PowerPC::HostRead_U32(0x80479C30 + 8);
+			u32 trlo = PowerPC::HostRead_U32(0x80479C30 + 12);
+			// The index HANDLE_CONNECTED actually passes to
+			// Inputs_GetPlayerHeldInputs, and the controller_map entry it selects.
+			// Entry 0 and the union are the control: if those hold Z and the
+			// selected one does not, the index is the fault.
+			u32 r13b = PowerPC::ppcState.gpr[13];
+			int cssCtl = (r13b >= 0x80000000 && r13b < 0x81800000)
+			                 ? PowerPC::HostRead_U8(r13b - 0x49B0)
+			                 : -1;
+			u32 selLo = (cssCtl >= 0 && cssCtl < 5)
+			                ? PowerPC::HostRead_U32(0x80479C30 + (u32)cssCtl * 0x30 + 4)
+			                : 0xDEADBEEF;
+			if ((p1hi | p1lo | alhi | allo | trhi | trlo) != 0 || (mapTick % 1800) == 1)
+				ERROR_LOG(SLIPPI_ONLINE,
+				          "[Direct] scene %02x%02x map p1 %08x%08x all %08x%08x trig %08x%08x | cssCtl %d sel %08x",
+				          (int)minor, (int)major, p1hi, p1lo, alhi, allo, trhi, trlo, cssCtl, selLo);
+		}
+	}
+
+	if (g_directPressEnabled.load(std::memory_order_acquire))
+	{
+		static bool installed = false;
+		if (!installed)
+		{
+			Movie::SetGCInputManip(directInputManip);
+			installed = true;
+			ERROR_LOG(SLIPPI_ONLINE, "[Direct] input hook installed");
+		}
+	}
+
+// --- direct mode: the online menus, without the menus -------------------
+//
+// Everything the Online Play screens produce is state, and there are only
+// two pieces of it: a match request, and a locked-in character. The game
+// makes the first when a mode is confirmed (CMD_FIND_OPPONENT) and the
+// second at the character-select lock-in (CMD_SET_MATCH_SELECTIONS). Under
+// the harness that drives this emulator nothing can press either button --
+// see tools/slippi/direct-connect.md -- so produce the state here instead.
+//
+// This is not a shortcut around the protocol. Both pieces go through the
+// same paths the menus use: FindMatch with an ordinary search, and
