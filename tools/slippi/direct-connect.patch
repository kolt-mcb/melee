+			if (!said)
+			{
+				said = true;
+				ERROR_LOG(SLIPPI_ONLINE, "[Direct] not locking in; leaving it to the game");
+			}
+			return;
+		}
+		const char *charEnv = getenv("SLIPPI_DIRECT_CHAR");
+		const char *stageEnv = getenv("SLIPPI_DIRECT_STAGE");
+
+		SlippiPlayerSelections sel;
+		sel.characterId = charEnv != nullptr ? (u8)atoi(charEnv) : 9;
+		sel.characterColor = 0;
+		sel.isCharacterSelected = true;
+		sel.teamId = 0;
+		sel.stageId = stageEnv != nullptr ? (u16)atoi(stageEnv) : 0;
+		sel.isStageSelected = stageEnv != nullptr;
+		sel.rngOffset = 0;
+
+		// Merge does not carry the index, and every reader of these
+		// selections finds its peer by it.
+		localSelections.playerIdx = matchmaking->LocalPlayerIndex();
+		localSelections.Merge(sel);
+		slippi_netplay->SetMatchSelections(localSelections);
+
+		ERROR_LOG(SLIPPI_ONLINE, "[Direct] locked in character %d as player %d",
+		          (int)localSelections.characterId, (int)localSelections.playerIdx);
+
+		// Telling Dolphin a character is chosen is not the same as the game having
+		// chosen one. The game keeps its own character-select state, and the screen
+		// still reads "Select your character": the hand never moved, so nothing was
+		// ever picked off the grid. Write the two things the codeset reads, where
+		// FN_TX_LOCK_IN reads them -- selections base at -0x49f0(r13), 0x24 per
+		// player, character id at +0x70 and colour at +0x73 -- and the "a character
+		// has been selected" byte the handler checks at -0x49A9(r13).
+		u32 r13 = PowerPC::ppcState.gpr[13];
+		if (r13 >= 0x80000000 && r13 < 0x81800000)
+		{
+			u32 selBase = PowerPC::HostRead_U32(r13 - 0x49f0);
+			u8 cssIdx = PowerPC::HostRead_U8(r13 - 0x5108);
+			if (selBase >= 0x80000000 && selBase < 0x81800000 && cssIdx < 4)
+			{
+				u32 entry = selBase + (u32)cssIdx * 0x24;
+				PowerPC::HostWrite_U8(localSelections.characterId, entry + 0x70);
+				PowerPC::HostWrite_U8(localSelections.characterColor, entry + 0x73);
+				PowerPC::HostWrite_U8(1, r13 - 0x49A9);
