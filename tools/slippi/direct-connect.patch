+// Direct mode can press its own buttons.
+//
+// The pipe controller does not reach this emulator -- the device is created and
+// read and the game still never sees a press (tools/slippi/direct-connect.md) --
+// but Dolphin hands every pad status through Movie::CallGCInputManip on its way
+// to the game, which is the same place the TAS input dialog writes. Nothing
+// external is involved, so there is no window focus, no device binding and no
+// /dev/uinput to arrange.
+//
+// The sequence is deliberately not a recorded route. It taps A until the thing
+// it is waiting for has happened, so it does not depend on how long a boot took
+// or how many frames a transition ran for.
+static std::atomic<int> g_directPressPhase(0);   // 0 = confirm a mode, 1 = character select, 2 = done
+static std::atomic<bool> g_directPressEnabled(false);
+
+static void directInputManip(GCPadStatus *pad, int controllerID)
+{
+	if (controllerID != 0 || !g_directPressEnabled.load(std::memory_order_acquire))
+		return;
+
+	int phase = g_directPressPhase.load(std::memory_order_acquire);
+	if (phase >= 2)
+		return;
+
+	// One clock for the whole sequence, advanced once per frame rather than
+	// once per port: this is called for every controller, so counting in here
+	// without the guard runs the script at double speed.
+	static int tick = 0;
+	if (controllerID == 0)
+	{
+		if (tick == 0)
+			ERROR_LOG(SLIPPI_ONLINE, "[Direct] the injector is being called");
+		tick++;
+	}
+
+	// Present a whole controller, not just a button. Port 1 is mapped to a pipe
+	// device that never binds, so what arrives here is an empty status with an
+	// error in it -- and a port the game believes is empty cannot operate a
+	// menu no matter what buttons are set on it.
+	pad->err = PAD_ERR_NONE;
+	pad->stickX = GCPadStatus::MAIN_STICK_CENTER_X;
+	pad->stickY = GCPadStatus::MAIN_STICK_CENTER_Y;
+	pad->substickX = GCPadStatus::C_STICK_CENTER_X;
+	pad->substickY = GCPadStatus::C_STICK_CENTER_Y;
+	pad->triggerLeft = 0;
+	pad->triggerRight = 0;
+	pad->analogA = 0;
+	pad->analogB = 0;
+	pad->button = PAD_USE_ORIGIN;
+
+	// Alternate A and Start, four frames held out of every thirty. Which one a
+	// Slippi menu takes is not documented anywhere and the screens differ, so
+	// this offers both rather than assuming; the taps are short enough that a
+	// screen which wants the other one is not disturbed by the wrong press.
+	// SLIPPI_DIRECT_PRESS=stick is the diagnostic rather than the driver: it
+	// only pushes the stick down, once a second. If the cursor on the mode list
+	// moves, the game is reading this pad and only the confirming button is
+	// wrong; if it does not, the codeset is not reading the SI path at all and
+	// no button would ever have worked.
+	static const char *pressMode = getenv("SLIPPI_DIRECT_PRESS");
+	if (pressMode != nullptr && strcmp(pressMode, "stick") == 0)
+	{
+		if ((tick % 60) < 8)
+			pad->stickY = 0x10;          // hard down
+		return;
+	}
+
+	int slot = (tick / 30) % 2;
+	if ((tick % 30) < 4)
+		pad->button |= (slot == 0) ? PAD_BUTTON_A : PAD_BUTTON_START;
+
+	if ((tick % 600) == 0)
+		ERROR_LOG(SLIPPI_ONLINE, "[Direct] still pressing, phase %d",
+		          g_directPressPhase.load(std::memory_order_acquire));
+}
