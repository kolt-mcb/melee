 {
+	// --- direct mode -------------------------------------------------------
+	//
+	// SLIPPI_DIRECT_PEERS=ip:port[,ip:port...] skips the matchmaking service
+	// entirely and connects to peers whose addresses we already know. Online
+	// play normally learns them from mm.slippi.gg, which means a peer has to be
+	// a Slippi client with an account; this exists so it can be something else
+	// on the same LAN -- here, a decompilation of the game being checked against
+	// this emulator frame by frame.
+	//
+	// Everything the service would have supplied comes from the environment
+	// instead: our own listen port, which player index we are, and whether we
+	// are the decider whose RNG seed the others adopt. Nothing else about the
+	// session changes -- handleConnecting builds the same SlippiNetplayClient
+	// from the same fields, so the wire, the rollback and the codeset checks are
+	// all still whatever they were.
+	{
+		const char *peersEnv = getenv("SLIPPI_DIRECT_PEERS");
+		if (peersEnv != nullptr && peersEnv[0] != '\0')
+		{
+			const char *portEnv = getenv("SLIPPI_DIRECT_PORT");
+			const char *idxEnv = getenv("SLIPPI_DIRECT_INDEX");
+			const char *decEnv = getenv("SLIPPI_DIRECT_DECIDER");
+
+			m_remoteIps.clear();
+			std::vector<std::string> peerParts;
+			SplitString(std::string(peersEnv), ',', peerParts);
+			for (auto &peer : peerParts)
+			{
+				if (!peer.empty())
+					m_remoteIps.push_back(peer);
+			}
+
+			m_hostPort = portEnv != nullptr ? atoi(portEnv) : 51442;
+			m_localPlayerIndex = idxEnv != nullptr ? atoi(idxEnv) : 0;
+			// The decider is whoever the others take the seed from. Default to
+			// player 0 so a two-machine session needs one variable, not three.
+			m_isHost = decEnv != nullptr ? (atoi(decEnv) != 0) : (m_localPlayerIndex == 0);
+			m_joinedLobby = false;
+			m_allowedStages.clear();
+
+			// One entry per player: RemotePlayerCount() and the name lookups
+			// read this, and an empty vector makes the first of them return 0
+			// and the second index out of bounds.
+			m_playerInfo.clear();
+			for (size_t i = 0; i < m_remoteIps.size() + 1; i++)
+			{
+				SlippiUser::UserInfo info;
+				info.port = (int)i + 1;
+				info.displayName = i == (size_t)m_localPlayerIndex ? "local" : "direct";
+				info.connectCode = "DIRECT#000";
+				m_playerInfo.push_back(info);
+			}
+
+			// The service fills this from its response; nothing did here, so
+			// `items` -- a u32 member with no initialiser -- was whatever the
+			// heap held, and prepareOnlineMatchState turned items on at high
+			// frequency whenever that was not zero. Some sessions played with
