+void CEXISlippi::directModeAutoDrive()
+{
+	// Installed here, not in the constructor: DolphinWX's frame installs its
+	// own TAS manip function while it sets itself up, which is after the EXI
+	// device exists, so anything registered earlier is simply replaced.
+	if (g_directPressEnabled.load(std::memory_order_acquire))
+	{
+		static bool installed = false;
+		if (!installed)
+		{
+			Movie::SetGCInputManip(directInputManip);
+			installed = true;
+			ERROR_LOG(SLIPPI_ONLINE, "[Direct] input hook installed");
+		}
+	}
+
+// --- direct mode: the online menus, without the menus -------------------
+//
+// Everything the Online Play screens produce is state, and there are only
+// two pieces of it: a match request, and a locked-in character. The game
+// makes the first when a mode is confirmed (CMD_FIND_OPPONENT) and the
+// second at the character-select lock-in (CMD_SET_MATCH_SELECTIONS). Under
+// the harness that drives this emulator nothing can press either button --
+// see tools/slippi/direct-connect.md -- so produce the state here instead.
+//
+// This is not a shortcut around the protocol. Both pieces go through the
+// same paths the menus use: FindMatch with an ordinary search, and
+// SetMatchSelections on the same netplay client, so what goes out on the
+// wire is what a Slippi client would have sent.
+//
+// SLIPPI_DIRECT_CHAR is an external character-select id, the numbering the
+// codeset itself writes: 9 is Marth, 20 is Falco. SLIPPI_DIRECT_STAGE is
+// optional, and only the lowest player index that names one is used.
+if (getenv("SLIPPI_DIRECT_PEERS") != nullptr)
+{
+	auto directState = matchmaking->GetMatchmakeState();
+
+	// Pressing buttons and asking for the match directly are alternatives,
+	// not companions: if the request has already been made, confirming the
+	// mode again puts the game and the matchmaker in different places.
+	if (g_directPressEnabled.load(std::memory_order_acquire))
+	{
+		if (directState != SlippiMatchmaking::ProcessState::IDLE &&
+		    g_directPressPhase.load(std::memory_order_acquire) == 0)
+		{
+			ERROR_LOG(SLIPPI_ONLINE, "[Direct] a mode was confirmed; on to the character select");
+			g_directPressPhase.store(1, std::memory_order_release);
+		}
+		if (localSelections.isCharacterSelected &&
+		    g_directPressPhase.load(std::memory_order_acquire) == 1)
+		{
+			ERROR_LOG(SLIPPI_ONLINE, "[Direct] a character is locked in");
+			g_directPressPhase.store(2, std::memory_order_release);
+		}
+		// Timing, not exclusivity. Asking for the match while the game is still on
+		// the mode list puts matchmaking out of IDLE, and the mode list then never
+		// advances -- pressing A on it does nothing for the rest of the run. So
+		// hold off until the game asks for match state, which it only does from
+		// the character select, and then let the rest run.
+		if (!g_directOnCss.load(std::memory_order_acquire))
+			return;
+	}
+
+	if (directState == SlippiMatchmaking::ProcessState::IDLE)
+	{
+		SlippiMatchmaking::MatchSearchSettings search;
+		search.mode = SlippiMatchmaking::OnlinePlayMode::UNRANKED;
+		search.connectCode = "";
+		lastSearch = search;
+
+		if (!isEnetInitialized)
+		{
+			if (enet_initialize() < 0)
+				ERROR_LOG(SLIPPI_ONLINE, "[Direct] enet_initialize failed");
+			isEnetInitialized = true;
+		}
+
+		ERROR_LOG(SLIPPI_ONLINE, "[Direct] requesting a match with no menu");
+		matchmaking->FindMatch(search);
+	}
+	else if (directState == SlippiMatchmaking::ProcessState::CONNECTION_SUCCESS)
+	{
+		// prepareOnlineMatchState takes the client off matchmaking once the
+		// connection lands. It never runs here, so nothing else will, and the
+		// pointer staying null is also what defeated the cleanup guard.
+		if (slippi_netplay == nullptr)
+		{
+			slippi_netplay = matchmaking->GetNetplayClient();
+			if (slippi_netplay != nullptr)
+				ERROR_LOG(SLIPPI_ONLINE, "[Direct] adopted the netplay client");
+		}
+		if (slippi_netplay == nullptr || localSelections.isCharacterSelected)
+			return;
+		const char *charEnv = getenv("SLIPPI_DIRECT_CHAR");
+		const char *stageEnv = getenv("SLIPPI_DIRECT_STAGE");
+
+		SlippiPlayerSelections sel;
+		sel.characterId = charEnv != nullptr ? (u8)atoi(charEnv) : 9;
+		sel.characterColor = 0;
+		sel.isCharacterSelected = true;
+		sel.teamId = 0;
+		sel.stageId = stageEnv != nullptr ? (u16)atoi(stageEnv) : 0;
+		sel.isStageSelected = stageEnv != nullptr;
+		sel.rngOffset = 0;
+
+		// Merge does not carry the index, and every reader of these
+		// selections finds its peer by it.
+		localSelections.playerIdx = matchmaking->LocalPlayerIndex();
+		localSelections.Merge(sel);
+		slippi_netplay->SetMatchSelections(localSelections);
+
+		ERROR_LOG(SLIPPI_ONLINE, "[Direct] locked in character %d as player %d",
+		          (int)localSelections.characterId, (int)localSelections.playerIdx);
+	}
+}
+}
