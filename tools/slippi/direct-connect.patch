+// Direct mode can press its own buttons.
+//
+// The pipe controller does not reach this emulator -- the device is created and
+// read and the game still never sees a press (tools/slippi/direct-connect.md) --
+// but Dolphin hands every pad status through Movie::CallGCInputManip on its way
+// to the game, which is the same place the TAS input dialog writes. Nothing
+// external is involved, so there is no window focus, no device binding and no
+// /dev/uinput to arrange.
+//
+// The sequence is deliberately not a recorded route. It taps A until the thing
+// it is waiting for has happened, so it does not depend on how long a boot took
+// or how many frames a transition ran for.
+static std::atomic<int> g_directPressPhase(0);   // 0 = confirm a mode, 1 = character select, 2 = done
+static std::atomic<bool> g_directPressEnabled(false);
+// Set the first time the game asks for match state. Nothing else says
+// "the mode list is behind us": that request is made by FetchMatchInfo.asm,
+// which runs only on the online character select.
+static std::atomic<bool> g_directOnCss(false);
+
+static void directInputManip(GCPadStatus *pad, int controllerID)
+{
+	if (controllerID != 0 || !g_directPressEnabled.load(std::memory_order_acquire))
+		return;
+
+	int phase = g_directPressPhase.load(std::memory_order_acquire);
+	if (phase >= 2)
+		return;
+
+	// One clock for the whole sequence, advanced once per frame rather than
+	// once per port: this is called for every controller, so counting in here
+	// without the guard runs the script at double speed.
+	static int tick = 0;
+	if (controllerID == 0)
+	{
+		if (tick == 0)
+			ERROR_LOG(SLIPPI_ONLINE, "[Direct] the injector is being called");
+		tick++;
+	}
+
+	// Present a whole controller, not just a button. Port 1 is mapped to a pipe
+	// device that never binds, so what arrives here is an empty status with an
+	// error in it -- and a port the game believes is empty cannot operate a
+	// menu no matter what buttons are set on it.
+	pad->err = PAD_ERR_NONE;
+	pad->stickX = GCPadStatus::MAIN_STICK_CENTER_X;
+	pad->stickY = GCPadStatus::MAIN_STICK_CENTER_Y;
+	pad->substickX = GCPadStatus::C_STICK_CENTER_X;
+	pad->substickY = GCPadStatus::C_STICK_CENTER_Y;
+	pad->triggerLeft = 0;
+	pad->triggerRight = 0;
+	pad->analogA = 0;
+	pad->analogB = 0;
+	pad->button = PAD_USE_ORIGIN;
+
+	// Alternate A and Start, four frames held out of every thirty. Which one a
+	// Slippi menu takes is not documented anywhere and the screens differ, so
+	// this offers both rather than assuming; the taps are short enough that a
+	// screen which wants the other one is not disturbed by the wrong press.
+	// SLIPPI_DIRECT_PRESS=stick is the diagnostic rather than the driver: it
+	// only pushes the stick down, once a second. If the cursor on the mode list
+	// moves, the game is reading this pad and only the confirming button is
+	// wrong; if it does not, the codeset is not reading the SI path at all and
+	// no button would ever have worked.
+	// Probe modes. Each one does a single thing for the whole run, so what the
+	// screen does in response is unambiguous -- which is the only way to tell a
+	// screen that ignores the pad from a screen that is being sent the wrong
+	// button.
+	//
+	//   stick        push down once a second
+	//   stickup      push up once a second
+	//   a b start z  tap that button once a second, and nothing else
+	static const char *pressMode = getenv("SLIPPI_DIRECT_PRESS");
+	bool isProbe = pressMode != nullptr && strcmp(pressMode, "1") != 0;
+
+	// A probe still has to get to the screen it is probing. Gated on having seen
+	// a match-state request rather than on a timer: the clock here starts at the
+	// first EXI poll and the mode list does not appear for twenty-five seconds,
+	// so any fixed window either expires before there is anything to press or
+	// keeps pressing long after.
+	if (isProbe && !g_directOnCss.load(std::memory_order_acquire))
+	{
+		if ((tick % 30) < 4)
+			pad->button |= PAD_BUTTON_A;
+		return;
+	}
+
+	if (pressMode != nullptr)
+	{
+		if (strcmp(pressMode, "stick") == 0)
+		{
+			if ((tick % 60) < 8)
+				pad->stickY = 0x10;
+			return;
+		}
+		if (strcmp(pressMode, "stickup") == 0)
+		{
+			if ((tick % 60) < 8)
+				pad->stickY = 0xF0;
+			return;
+		}
+		// Held, not tapped. HANDLE_CONNECTED counts Z one frame at a time up to
+		// DISCONNECT_HOLD_DELAY (0x30) and resets the count the moment it is
+		// released, so a tap can never reach the threshold.
+		if (strcmp(pressMode, "zhold") == 0)
+		{
+			pad->button |= PAD_TRIGGER_Z;
+			pad->triggerLeft = 0;
+			pad->triggerRight = 0;
+			return;
+		}
+		u16 probe = 0;
+		if (strcmp(pressMode, "a") == 0)
+			probe = PAD_BUTTON_A;
+		else if (strcmp(pressMode, "b") == 0)
+			probe = PAD_BUTTON_B;
+		else if (strcmp(pressMode, "start") == 0)
+			probe = PAD_BUTTON_START;
+		else if (strcmp(pressMode, "z") == 0)
+			probe = PAD_TRIGGER_Z;
+		if (probe != 0)
+		{
+			if ((tick % 60) < 6)
+				pad->button |= probe;
+			return;
+		}
+	}
+
+	// Only the mode list is driven by pressing, and only with A. Alternating A
+	// and Start -- an earlier guess at which button confirms -- opens the next
+	// screen and immediately leaves it again, which looks exactly like a pad
+	// nothing reads.
+	//
+	// The character select is not driven at all: it ignores this pad completely,
+	// B does not back out of it and no stick push moves the hand. It does not
+	// need to be. HandleInputsOnCSS.asm ends at CHECK_SHOULD_START_MATCH, which
+	// starts the game as soon as Dolphin reports both players ready:
+	//
+	//     lbz r3, MSRB_IS_LOCAL_PLAYER_READY(REG_MSRB_ADDR)
+	//     lbz r4, MSRB_IS_REMOTE_PLAYER_READY(REG_MSRB_ADDR)
+	//     and. r3, r3, r4
+	//
+	// Local readiness is localSelections.isCharacterSelected, which is what
+	// directModeAutoDrive sets; remote readiness arrives from the peer.
+	// Not "for the first ten seconds": the clock starts at the first EXI poll,
+	// early in boot, and the mode list does not appear for twenty-five. A
+	// window that short spends itself before there is anything to press.
+	// Tapping for the whole run costs nothing, because the screen after the
+	// mode list ignores this pad entirely.
+	if ((tick % 30) < 4)
+		pad->button |= PAD_BUTTON_A;
+
+	if ((tick % 600) == 0)
+		ERROR_LOG(SLIPPI_ONLINE, "[Direct] still pressing, phase %d",
+		          g_directPressPhase.load(std::memory_order_acquire));
+}
