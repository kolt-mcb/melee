+			return;
+
+		// SLIPPI_DIRECT_NOLOCK leaves the lock-in to the game.
+		//
+		// Reporting isCharacterSelected before the game has chosen anything is
+		// not neutral: PreventAPressCharUnselect.asm and its B counterpart read
+		// MSRB_IS_LOCAL_PLAYER_READY and skip the character-select input
